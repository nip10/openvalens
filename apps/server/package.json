{
  "name": "server",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen",
    "storage:migrate": "bun run src/storage-migrate.ts",
    "auth:generate": "bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@openvalens/ai": "workspace:*",
    "@openvalens/api": "workspace:*",
    "@openvalens/auth": "workspace:*",
    "@openvalens/body": "workspace:*",
    "@openvalens/config": "workspace:*",
    "@openvalens/db": "workspace:*",
    "@openvalens/email": "workspace:*",
    "@openvalens/nutrition": "workspace:*",
    "@openvalens/observability": "workspace:*",
    "@openvalens/push": "workspace:*",
    "@openvalens/storage": "workspace:*",
    "@openvalens/telegram": "workspace:*",
    "@openvalens/wearables": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "sharp": "^0.34.5",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
