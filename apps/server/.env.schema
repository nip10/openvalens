# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# CSP rollout mode. `report-only` (default) emits a report-only header; `enforce`
# emits the enforced policy. An invalid value fails startup rather than falling back.
# @public @type=enum(report-only, enforce)
CSP_MODE=report-only

# Where users of this instance can get its source code, linked from the settings
# screens (AGPL-3.0 section 13). Keep the default for an unmodified release; if
# you run a modified version, point it at your fork's public repository.
# @public @type=url
SOURCE_CODE_URL=https://github.com/nip10/openvalens

# ─── Deployment mode (Issue #294) ───────────────────────────────

# `self-hosted` (default): invite-only, people join through /setup or an
# invitation. `cloud`: OpenValens Cloud, where anyone can create an account at
# /signup. Cloud refuses to start without the LEGAL_* settings below.
# @public @type=enum(self-hosted, cloud)
DEPLOYMENT_MODE=self-hosted

# Cloud only: the terms of service page linked from the sign-up form.
# @optional @public @type=url
LEGAL_TERMS_URL=

# Cloud only: the terms version recorded with every sign-up, e.g. `2026-11-01`.
# @optional @public @type=string
LEGAL_TERMS_VERSION=

# Cloud only: the privacy policy page linked from the sign-up form.
# @optional @public @type=url
LEGAL_PRIVACY_URL=

# Cloud only: the privacy policy version recorded with every sign-up.
# @optional @public @type=string
LEGAL_PRIVACY_VERSION=

# Cloud only: version recorded when a person separately consents to health-data
# processing. The consent link uses LEGAL_PRIVACY_URL; self-host ignores this.
# @optional @public @type=string
LEGAL_HEALTH_CONSENT_VERSION=

# ─── Cloud billing (Issue #297) ─────────────────────────────────

# Cloud only: Stripe API key for subscriptions. A restricted key (`rk_`) with
# write access to Customers, Checkout Sessions, Customer Portal and
# Subscriptions and read access to Prices is recommended. Ignored on self-host.
# @optional @sensitive @type=string
STRIPE_SECRET_KEY=

# Cloud only: signing secret (`whsec_`) of the Stripe webhook endpoint
# `https://<domain>/api/billing/webhook`.
# @optional @sensitive @type=string
STRIPE_WEBHOOK_SECRET=

# Cloud only: Stripe price id (`price_`) of the monthly plan (EUR 7.99, VAT included).
# @optional @public @type=string
STRIPE_PRICE_MONTHLY=

# Cloud only: Stripe price id (`price_`) of the annual plan (EUR 69, VAT included).
# @optional @public @type=string
STRIPE_PRICE_ANNUAL=

# Cloud only: reviewed checkout acknowledgement text version (required for
# Cloud billing). Set only after
# legal approval; required at Cloud startup and never supplied by the client.
# @optional @public @type=string
LEGAL_CHECKOUT_ACK_VERSION=

# ─── Cloud subscription states (Issue #298) ─────────────────────

# Cloud only: days a workspace keeps full access after a renewal payment fails
# (`past_due`), before it becomes read-only. Ignored on self-host.
# @type=number(min=0, max=60) @sensitive=false
BILLING_PAST_DUE_GRACE_DAYS=7

# Cloud only: months an owner's access may stay ended before their account and
# records are deleted (a warning email goes out 30 days before). Unset (the
# default) never deletes. State the value in the privacy policy.
# @optional @type=number(min=1, max=120) @sensitive=false
CLOUD_ENDED_RETENTION_MONTHS=

# Cloud only: count and log the retention warnings and deletions that are due
# without sending or deleting anything.
# @type=boolean @sensitive=false
CLOUD_ENDED_RETENTION_DRY_RUN=false

# @type=string(minLength=1)
DATABASE_URL=

# Bearer token required by cron-only oRPC procedures (`cronProcedure`).
# @type=string(minLength=16)
CRON_SECRET=

# ─── Email (Issue #15) ──────────────────────────────────────────

# Resend API key. When unset, email sends are dry-run only.
# @optional @sensitive @type=string
RESEND_API_KEY=

# Sender address, e.g. `Health <noreply@health.example>`.
# @type=string(minLength=5) @sensitive=false
EMAIL_FROM=

# Reply-to address. Defaults to the sender address when unset.
# @optional @type=email @sensitive=false
EMAIL_REPLY_TO=

# Compliance mailbox that receives a BCC receipt of sensitive flows.
# @optional @sensitive @type=email
EMAIL_AUDIT_BCC=

# Skip the provider call and log a dry-run event. Forced on when no API key.
# @type=boolean @sensitive=false
EMAIL_DRY_RUN=true

# Local development only: print magic sign-in links to the server console when
# email is a dry run (no RESEND_API_KEY). This exposes a sign-in credential in
# console output, which may be retained; enabled only when NODE_ENV=development.
# @optional @type=boolean @sensitive=false
AUTH_DEV_MAGIC_LINK_CONSOLE=false

# ─── Telegram (Issue #14) ───────────────────────────────────────

# Bot token from @BotFather. When unset, Telegram delivery is disabled.
# @optional @sensitive @type=string
TELEGRAM_BOT_TOKEN=

# Secret echoed by Telegram in `X-Telegram-Bot-Api-Secret-Token`.
# @type=string(minLength=16)
TELEGRAM_WEBHOOK_SECRET=

# Connect-token TTL in seconds.
# @type=number @sensitive=false
TELEGRAM_CONNECT_TOKEN_TTL_SECONDS=600

# Telegram Bot API base URL (override for local testing).
# @type=string(minLength=1) @sensitive=false
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ─── AI provider (Issues #13, #59) ──────────────────────────────

# AI provider: `anthropic` or `openai-compatible` (Ollama, vLLM, llama.cpp,
# LM Studio, hosted OpenAI-compatible APIs). When unset, AI is off (readiness
# reports `ai: off`, `ai.chat` fails closed) unless the legacy
# `ANTHROPIC_API_KEY` is set, which selects `anthropic`.
# @optional @type=enum(anthropic, openai-compatible) @sensitive=false
AI_PROVIDER=

# Base URL of the provider API, for example `http://localhost:11434/v1`.
# Required for `openai-compatible`; an optional proxy override for `anthropic`.
# Must not embed credentials. Only its host is ever logged.
# @optional @type=url @sensitive=false
AI_BASE_URL=

# API key for the selected provider. Optional for local OpenAI-compatible
# servers. For `anthropic`, falls back to `ANTHROPIC_API_KEY`.
# @optional @sensitive @type=string
AI_API_KEY=

# Legacy Anthropic API key. When unset (and `AI_API_KEY` is unset), the
# Anthropic provider stays off: readiness reports `anthropic: false` and
# `ai.chat` fails closed.
# @optional @sensitive @type=string
ANTHROPIC_API_KEY=

# Model id. Defaults to `claude-sonnet-5-5` for `anthropic` (must be a current
# Claude API model id). Required for `openai-compatible`; no local model is
# hard-coded (see docs/ai-providers.md).
# @optional @type=string(minLength=1) @sensitive=false
AI_MODEL=

# Whether the endpoint honours JSON-schema structured outputs. When `false`
# (default), extraction asks for JSON in plain text and validates it.
# @optional @type=boolean @sensitive=false
AI_SUPPORTS_STRUCTURED_OUTPUTS=

# Per-(userId, organizationId) chat budget, in requests per minute.
# @type=number @sensitive=false
AI_RATE_LIMIT_PER_MINUTE=20

# ─── AI monthly usage cap (Issue #299) ──────────────────────────

# Monthly AI cost limit per person, in AI_COST_CURRENCY (for example `1.50`).
# Usage is counted per calendar month (UTC); a person who reaches the limit
# can't use AI again until the 1st. Unset = no cap (tokens are still counted).
# Needs AI_PRICE_INPUT_PER_MTOK and AI_PRICE_OUTPUT_PER_MTOK. Required when
# DEPLOYMENT_MODE=cloud and AI is configured.
# @optional @type=number(min=0) @sensitive=false
AI_MONTHLY_COST_LIMIT=

# Price of one million input tokens of AI_MODEL, in AI_COST_CURRENCY, used to
# estimate cost. Set together with AI_PRICE_OUTPUT_PER_MTOK.
# @optional @type=number(min=0) @sensitive=false
AI_PRICE_INPUT_PER_MTOK=

# Price of one million output tokens of AI_MODEL, in AI_COST_CURRENCY.
# @optional @type=number(min=0) @sensitive=false
AI_PRICE_OUTPUT_PER_MTOK=

# Price of one million cached input tokens (prompt-cache reads), in
# AI_COST_CURRENCY. Defaults to AI_PRICE_INPUT_PER_MTOK.
# @optional @type=number(min=0) @sensitive=false
AI_PRICE_CACHED_INPUT_PER_MTOK=

# ISO 4217 currency of AI_MONTHLY_COST_LIMIT and the AI prices. Display only;
# no conversion is done. Defaults to `EUR`.
# @optional @type=string(minLength=3, maxLength=3) @sensitive=false
AI_COST_CURRENCY=

# ─── Live food lookup (Issue #69) ───────────────────────────────

# Optional live barcode lookup for codes missing from private foods and the
# imported catalogs. When unset, lookups stay local and the `foodLookup`
# integration reports `off`; manual food logging never needs it. Only the
# product code and FOOD_LOOKUP_USER_AGENT are sent upstream.
# @optional @type=enum(openfoodfacts) @sensitive=false
FOOD_LOOKUP_PROVIDER=

# Identifies this instance to the provider, as `AppName/Version (contact)`,
# e.g. `OpenValens/1.0 (ops@example.org)`. Required for live lookup; when
# missing or malformed, live lookup stays off. No user data.
# @optional @type=string @sensitive=false
FOOD_LOOKUP_USER_AGENT=

# Upstream or privacy-proxy origin. Defaults to the public Open Food Facts
# API. Must not embed credentials.
# @optional @type=url @sensitive=false
FOOD_LOOKUP_BASE_URL=

# ─── Push notifications (Issue #92) ─────────────────────────────

# Optional push transport for insight notifications. When unset, push is off:
# readiness reports `push: off` and the app shows push as unavailable. `expo`
# uses the Expo push service (which forwards to APNs/FCM). The server needs no
# credential, but phones only register when the app was built with an EAS
# project ID whose EAS project holds APNs and FCM credentials; see
# docs/self-hosting/mobile-app.md. Pushes only ever carry generic text ("You
# have a new insight"), never a health value.
# @optional @type=enum(expo) @sensitive=false
PUSH_PROVIDER=

# ─── OIDC sign-in (Issue #65) ───────────────────────────────────
#
# One optional generic OpenID Connect provider (Authentik, Keycloak, Zitadel,
# PocketID, Auth0, Google Workspace, …) next to magic-link sign-in. Enabled
# only when OIDC_PROVIDER_ID, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and
# OIDC_DISCOVERY_URL are all set. OIDC never creates accounts and never links
# by email: an identity is bound by a signed-in user from Settings.

# Stable provider id (lowercase letters, digits, hyphens). It appears in the
# redirect URI to register with the IdP: `<BETTER_AUTH_URL>/api/auth/callback/<id>`.
# Changing it orphans every existing binding.
# @optional @type=string(minLength=1) @sensitive=false
OIDC_PROVIDER_ID=

# OAuth client id registered with the IdP.
# @optional @type=string(minLength=1) @sensitive=false
OIDC_CLIENT_ID=

# OAuth client secret registered with the IdP.
# @optional @sensitive @type=string
OIDC_CLIENT_SECRET=

# OpenID discovery document URL, e.g.
# `https://idp.example/.well-known/openid-configuration`. Must be https
# (http only for localhost) and publish an issuer and `jwks_uri`.
# @optional @type=url @sensitive=false
OIDC_DISCOVERY_URL=

# Button label: "Continue with <name>". Defaults to "Single sign-on".
# @optional @type=string(maxLength=40) @sensitive=false
OIDC_DISPLAY_NAME=

# ─── Sign in with Google and Apple (Issue #296) ─────────────────
#
# Each provider is on only when all of its required keys are set. On a
# self-hosted server they sign in existing accounts only, bound from Settings;
# on OpenValens Cloud a new identity can also create an account. See
# docs/self-hosting/google-apple-sign-in.md.

# Google OAuth web client id (`….apps.googleusercontent.com`). Redirect URI:
# `<BETTER_AUTH_URL>/api/auth/callback/google`.
# @optional @type=string(minLength=1) @sensitive=false
GOOGLE_CLIENT_ID=

# Google OAuth web client secret.
# @optional @sensitive @type=string
GOOGLE_CLIENT_SECRET=

# Apple Services ID for web sign-in, e.g. `com.example.signin`. Return URL:
# `<BETTER_AUTH_URL>/api/auth/callback/apple`.
# @optional @type=string(minLength=1) @sensitive=false
APPLE_CLIENT_ID=

# Apple Developer Team ID (10 characters).
# @optional @type=string(minLength=1) @sensitive=false
APPLE_TEAM_ID=

# Key ID of the Sign in with Apple key (10 characters).
# @optional @type=string(minLength=1) @sensitive=false
APPLE_KEY_ID=

# Contents of the Sign in with Apple `.p8` key (PEM). The server signs a
# short-lived client secret with it; `\n` escapes are accepted.
# @optional @sensitive @type=string
APPLE_PRIVATE_KEY=

# The iOS app's bundle ID. Set it to allow the native Apple sheet in the app
# (`com.openvalens.app` for the store app).
# @optional @type=string(minLength=1) @sensitive=false
APPLE_APP_BUNDLE_ID=

# ─── HTTP body limit (Issue #126) ────────────────────────────────

# Maximum accepted request-body length, in bytes. Bodies larger than this
# are rejected with 413 before parsing — protecting the server from
# oversized uploads and from chunked / missing or forged `Content-Length`
# values that try to bypass the declared-size check. The photo upload
# procedures alone accept up to 11 MiB (10 MiB photo plus multipart framing),
# or this value if it is larger.
# @type=number(min=1) @sensitive=false
API_MAX_BODY_BYTES=1048576

# ─── Object storage (Issue #62) ─────────────────────────────────

# Where stored objects (today, progress photos) live:
# `local` (default) keeps them on the server's disk under STORAGE_LOCAL_DIR;
# `s3` uses any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, B2).
# Objects are always private: downloads are short-lived signed URLs minted
# after an authorization check. See docs/storage.md.
# @type=enum(local, s3) @sensitive=false
STORAGE_PROVIDER=local

# Root directory for `local` storage. Relative paths resolve from the server's
# working directory. The production compose stack mounts the `storage` volume
# at /var/lib/openvalens/storage; back this directory up with the database.
# @type=string(minLength=1) @sensitive=false
STORAGE_LOCAL_DIR=./.data/storage

# Private, persistent working directory for subject data-export archives.
# Mount a volume here in production. Archives are temporary user data and are
# deliberately not included in backups. Multiple replicas require shared disk.
# @type=string(minLength=1) @sensitive=false
DATA_EXPORT_DIR=/var/lib/openvalens/exports

# Largest object accepted, in bytes (default 25 MiB, at most 100 MiB).
# @type=number(min=1, max=104857600) @sensitive=false
STORAGE_MAX_OBJECT_BYTES=26214400

# Lifetime of a signed download URL, in seconds (at most 3600).
# @type=number(min=1, max=3600) @sensitive=false
STORAGE_SIGNED_URL_TTL_SECONDS=300

# S3-compatible endpoint origin, for example `https://<account>.r2.cloudflarestorage.com`
# or `http://minio:9000`. Defaults to the AWS regional endpoint. Must not embed
# credentials; never logged or reported.
# @optional @type=url @sensitive=false
STORAGE_S3_ENDPOINT=

# Region used for request signing (`auto` for Cloudflare R2).
# @optional @type=string(minLength=1) @sensitive=false
STORAGE_S3_REGION=

# Bucket name. Keep the bucket private: OpenValens never needs public access.
# @optional @type=string(minLength=3) @sensitive=false
STORAGE_S3_BUCKET=

# Access key id. When the bucket or either key is unset with `STORAGE_PROVIDER=s3`,
# storage is off (readiness reports `storage: off`) and uploads fail closed.
# @optional @sensitive @type=string
STORAGE_S3_ACCESS_KEY_ID=

# Secret access key.
# @optional @sensitive @type=string
STORAGE_S3_SECRET_ACCESS_KEY=

# Path-style addressing (`endpoint/bucket/key`). Required for MinIO.
# @type=boolean @sensitive=false
STORAGE_S3_FORCE_PATH_STYLE=false

# Server-side encryption requested on every upload: `AES256` (SSE-S3, default)
# or `none` for endpoints that reject the header (MinIO without a KMS).
# @type=enum(AES256, none) @sensitive=false
STORAGE_S3_SSE=AES256

# ─── Optional product analytics (Issue #53) ──────────────────────
# Disabled unless explicitly enabled, a PostHog project token is present, and
# the operator attests that IP capture is disabled in the EU PostHog project.
# PostHog still receives the server's network IP; never claim anonymity.
# @type=boolean @sensitive=false
ANALYTICS_ENABLED=false

# EU PostHog project token (not a personal/admin API secret). Keep server-only.
# @optional @sensitive @type=string
POSTHOG_PROJECT_TOKEN=

# Operator attestation only: set true after disabling IP capture in the actual
# PostHog project. This setting does not itself configure PostHog.
# @type=boolean @sensitive=false
POSTHOG_IP_CAPTURE_DISABLED=false

# Metadata-approved exercise asset publication and own-origin serving. Off by
# default; no exercise asset route is mounted unless storage has a stable identity.
# @type=boolean @sensitive=false
EXERCISE_CATALOG_ASSETS_ENABLED=false

# ─── Optional error reporting (Issue #54) ───────────────────────
# Sentry DSN for server errors. Unset (the default) turns reporting off and
# nothing is sent. Events carry only the error type, code frames, release and
# environment: never messages, request data, user, headers or breadcrumbs.
# @optional @type=url @sensitive=false
SENTRY_DSN=

# Keeps production, staging and development events apart. Defaults to NODE_ENV.
# @optional @type=string(maxLength=64) @sensitive=false
SENTRY_ENVIRONMENT=

# Release tag, e.g. the deployed commit SHA, so source maps and the web and
# native events of the same deploy line up.
# @optional @type=string(maxLength=200) @sensitive=false
SENTRY_RELEASE=

# ─── Cloud wearables (Issue #60) ────────────────────────────────
#
# Wearable data reaches OpenValens through the phone first (HealthKit /
# Health Connect via the companion app), which needs no vendor account. The
# optional cloud adapters below add what the phone cannot carry (overnight HRV
# and the vendor's own scores). Each one is off until you register your OWN
# developer app with the vendor and set its client id and secret; there are no
# shared OpenValens credentials. Redirect URI to register:
# `<BETTER_AUTH_URL>/api/integrations/wearables/<provider>/callback`, where
# provider is `oura`, `whoop`, `polar`, `withings` or `google_health`. See
# docs/wearables.md.

# Ask vendors to call `<BETTER_AUTH_URL>/api/integrations/wearables/<provider>/webhook`
# (Withings notification subscriptions are created on connect). Needs public
# HTTPS ingress; without it, connections are synced by polling only.
# @type=boolean @sensitive=false
WEARABLES_WEBHOOKS=false

# Oura developer app client id.
# @optional @type=string(minLength=1) @sensitive=false
WEARABLES_OURA_CLIENT_ID=

# Oura developer app client secret (also verifies Oura webhook signatures).
# @optional @sensitive @type=string
WEARABLES_OURA_CLIENT_SECRET=

# WHOOP developer app client id.
# @optional @type=string(minLength=1) @sensitive=false
WEARABLES_WHOOP_CLIENT_ID=

# WHOOP developer app client secret (also verifies WHOOP webhook signatures).
# @optional @sensitive @type=string
WEARABLES_WHOOP_CLIENT_SECRET=

# Polar AccessLink client id.
# @optional @type=string(minLength=1) @sensitive=false
WEARABLES_POLAR_CLIENT_ID=

# Polar AccessLink client secret.
# @optional @sensitive @type=string
WEARABLES_POLAR_CLIENT_SECRET=

# `signature_secret_key` Polar returns when you create the AccessLink webhook.
# Without it, Polar webhooks are refused and Polar is polled.
# @optional @sensitive @type=string
WEARABLES_POLAR_WEBHOOK_SECRET=

# Withings public API client id.
# @optional @type=string(minLength=1) @sensitive=false
WEARABLES_WITHINGS_CLIENT_ID=

# Withings public API client secret.
# @optional @sensitive @type=string
WEARABLES_WITHINGS_CLIENT_SECRET=

# Google Health API (public preview): stays off unless `true`, even with
# credentials. An unverified app in Testing mode gets refresh tokens that
# expire after 7 days, so people must reconnect weekly (see docs/wearables.md).
# @type=boolean @sensitive=false
WEARABLES_GOOGLE_HEALTH_ENABLED=false

# Google Cloud OAuth client id for the Google Health API.
# @optional @type=string(minLength=1) @sensitive=false
WEARABLES_GOOGLE_HEALTH_CLIENT_ID=

# Google Cloud OAuth client secret for the Google Health API.
# @optional @sensitive @type=string
WEARABLES_GOOGLE_HEALTH_CLIENT_SECRET=
