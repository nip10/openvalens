# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Bearer token required by cron-only oRPC procedures (`cronProcedure`).
# @type=string(minLength=16)
CRON_SECRET=

# ─── Email (Issue #15) ──────────────────────────────────────────

# Resend API key. When unset, email sends are dry-run only.
# @optional @sensitive @type=string
RESEND_API_KEY=

# Sender address, e.g. `Health <noreply@health.example>`.
# @type=string(minLength=5) @sensitive=false
EMAIL_FROM=

# Reply-to address. Defaults to the sender address when unset.
# @optional @type=email @sensitive=false
EMAIL_REPLY_TO=

# Compliance mailbox that receives a BCC receipt of sensitive flows.
# @optional @sensitive @type=email
EMAIL_AUDIT_BCC=

# Skip the provider call and log a dry-run event. Forced on when no API key.
# @type=boolean @sensitive=false
EMAIL_DRY_RUN=true

# Local development only: print magic sign-in links to the server console when
# email is a dry run (no RESEND_API_KEY). This exposes a sign-in credential in
# console output, which may be retained; enabled only when NODE_ENV=development.
# @optional @type=boolean @sensitive=false
AUTH_DEV_MAGIC_LINK_CONSOLE=false

# ─── Telegram (Issue #14) ───────────────────────────────────────

# Bot token from @BotFather. When unset, Telegram delivery is disabled.
# @optional @sensitive @type=string
TELEGRAM_BOT_TOKEN=

# Secret echoed by Telegram in `X-Telegram-Bot-Api-Secret-Token`.
# @type=string(minLength=16)
TELEGRAM_WEBHOOK_SECRET=

# Connect-token TTL in seconds.
# @type=number @sensitive=false
TELEGRAM_CONNECT_TOKEN_TTL_SECONDS=600

# Telegram Bot API base URL (override for local testing).
# @type=string(minLength=1) @sensitive=false
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ─── Anthropic AI (Issue #13) ───────────────────────────────────

# Anthropic API key. When unset, AI features degrade gracefully: readiness
# reports `anthropic: false` and `ai.chat` fails closed.
# @optional @sensitive @type=string
ANTHROPIC_API_KEY=

# Model id used for chat. Must be a current Claude API model id.
# @type=string(minLength=1) @sensitive=false
AI_MODEL=claude-sonnet-5-5

# Per-(userId, organizationId) chat budget, in requests per minute.
# @type=number @sensitive=false
AI_RATE_LIMIT_PER_MINUTE=20
