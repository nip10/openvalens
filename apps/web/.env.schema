# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# ─── Optional error reporting (Issue #54) ───────────────────────
# Sentry DSN for browser errors, baked in at build time. Unset (the default)
# turns reporting off. Events are scrubbed to error type and code frames.
# @optional @public @type=url
VITE_SENTRY_DSN=

# Keeps production, staging and development events apart. Defaults to NODE_ENV.
# @optional @public @type=string
VITE_SENTRY_ENVIRONMENT=

# Release tag; use the same value as the server's SENTRY_RELEASE for a deploy.
# @optional @public @type=string
VITE_SENTRY_RELEASE=
