# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Optional server lock for your own build (#295). Unset (the store build), the
# app asks on first launch: OpenValens Cloud or your own server. Set to an
# origin such as https://health.example.org, the app connects only to it and
# hides "Change server".
# @optional @public @type=url
EXPO_PUBLIC_SERVER_URL=

# ─── Optional error reporting (Issue #54) ───────────────────────
# Sentry DSN for app errors, baked in at build time. Unset (the default) turns
# reporting off. JS errors only; events are scrubbed to error type and frames.
# @optional @public @type=url
EXPO_PUBLIC_SENTRY_DSN=

# Keeps production, staging and development events apart. Defaults to NODE_ENV.
# @optional @public @type=string
EXPO_PUBLIC_SENTRY_ENVIRONMENT=

# Release tag; use the same value as the server's SENTRY_RELEASE for a release.
# @optional @public @type=string
EXPO_PUBLIC_SENTRY_RELEASE=

# ─── Optional push notifications (Issue #92) ────────────────────
# EAS project ID (a UUID from expo.dev), read by app.config.ts at build time
# into `extra.eas.projectId`. Push registration needs it; unset (the default)
# shows push as unavailable in the app. An identifier, not a secret. The EAS
# project also needs APNs and FCM credentials; see
# docs/self-hosting/mobile-app.md.
# @optional @public @type=string
EXPO_PUBLIC_EAS_PROJECT_ID=

# Path to the Firebase `google-services.json`, read by app.config.ts at build
# time into `android.googleServicesFile`. Android needs it to receive pushes.
# @optional @sensitive=false @type=string
GOOGLE_SERVICES_JSON=
