# Rendered by the nginx image's envsubst step (only ${SITE_APP_URL} is set).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    gzip on;
    gzip_types text/plain text/css image/svg+xml application/atom+xml;

    # www.<domain> → <domain>, keeping the path.
    if ($host ~* ^www\.(.+)$) {
        return 301 https://$1$request_uri;
    }

    location = / {
        include /etc/nginx/site-security-headers.conf;
        try_files /index.html =404;
    }

    # The Atom feed of the changelog (#446); nginx would send .xml as text/xml.
    location = /changelog.xml {
        include /etc/nginx/site-security-headers.conf;
        add_header Cache-Control "public, max-age=3600";
        types { }
        default_type application/atom+xml;
        try_files /changelog.xml =404;
    }

    # Legal, support, changelog and device pages, served without the .html suffix.
    location ~ ^/(changelog|devices|privacy|subprocessors|support|terms)/?$ {
        include /etc/nginx/site-security-headers.conf;
        add_header Cache-Control "public, max-age=3600";
        try_files /$1.html =404;
    }

    location ~ ^/(index\.html|changelog\.html|changelog\.xml|devices\.html|privacy\.html|subprocessors\.html|support\.html|terms\.html|styles\.css|favicon\.svg|og\.png|screenshots/|badges/) {
        include /etc/nginx/site-security-headers.conf;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;
    }

    # Anything else belonged to the app before it moved (bookmarks, emailed
    # sign-in links, /rpc and /api calls from old clients): send it there.
    location / {
        return 301 ${SITE_APP_URL}$request_uri;
    }
}
