#!/bin/sh
# Example operator pre-migrate backup hook (Issue #63).
#
# To use it: copy to deploy/hooks/pre-migrate, make it executable, and set
# OPENVALENS_PRE_MIGRATE_BACKUP=hook in deploy/.env. It runs inside the
# `backup` service (the pinned Postgres image plus age) with PGHOST/PGUSER/PGDATABASE/PGPASSWORD
# set and the `backups` volume at /backups. Exit 0 ONLY after a backup you
# trust exists; any other exit code stops the upgrade before migrations run.
#
# Never print database contents or credentials.
set -eu

# The `backup` service is attached only to the internal `db` network, so this
# hook has NO internet access: it cannot upload anywhere. Write the dump to
# /backups here and copy it off the host from the host itself
# (docs/self-hosting/backup.md).
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
umask 077
pg_dump --format=custom --no-password --file="/backups/hook-$stamp.dump"
pg_restore --list "/backups/hook-$stamp.dump" >/dev/null
