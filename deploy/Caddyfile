# OpenValens edge proxy (Issue #63). Caddy is the only published service and
# obtains/renews TLS certificates automatically for OPENVALENS_DOMAIN.
# Web and API share one origin: API paths go to `server`, everything else to
# the static `web` app. Values come from deploy/.env (written by setup.sh).
{
	email {$ACME_EMAIL}
}

{$OPENVALENS_DOMAIN} {
	encode zstd gzip

	header Strict-Transport-Security "max-age=31536000"

	@api path /api /api/* /rpc /rpc/* /api-reference /api-reference/*
	handle @api {
		reverse_proxy server:3000
	}

	handle {
		reverse_proxy web:80
	}
}
